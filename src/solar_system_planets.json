    {
      "id": "NASA-SP",
      "title": "How Many Moons Does Each Planet Have?",
      "publisher": "NASA Space Place",
      "last_updated": "2026-07-31",
      "url": "https://spaceplace.nasa.gov/how-many-moons/en/",
      "description": "Latest 'known moons' counts as of mid-2026. Note: 'known' includes provisional and confirmed moons per NASA Space Place; IAU 'confirmed' counts may be slightly lower for Jupiter and Saturn, where many small irregular satellites are still being tracked."
    },
    {
      "id": "NASA-SAT",
      "title": "Saturn Moons",
      "publisher": "NASA Science — Solar System Exploration",
      "url": "https://science.nasa.gov/saturn/moons/",
      "description": "Cross-reference for Saturn's moon count: NASA Science reports 274 'confirmed' as of March 2025. NASA-SP reports 293 total 'known' as of June 2026 (128 new candidates confirmed in 2025)."
    }
  ],
  "conventions": {
    "epoch": "J2000.0 = JD 2451545.0 = 2000-01-01 12:00 TDB",
