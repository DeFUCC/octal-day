    },
    {
      "id": "NASA-FS",
      "title": "Planetary Fact Sheet - Metric",
      "author": "Dr. David R. Williams, NSSDC, NASA Goddard Space Flight Center",
      "last_updated": "2004-09-01",
      "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/",
      "mirror_url": "https://faculty.kfupm.edu.sa/PHYS/alshukri/Planetary_Fact_Sheet_2pages.htm",
